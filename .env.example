# Banco de Dados
DATABASE_URL="postgres://postgres:postgres@localhost:5432/valemchat"

# Porta do Servidor
PORT=3000

# Sistema de Ligações WebRTC
GROQ_API_KEY=""                    # console.groq.com — Whisper gratuito (2000 req/dia)
METERED_DOMAIN="tecfagchat.metered.live"   # metered.ca — TURN gratuito (50GB/mês)
METERED_SECRET_KEY=""             # Secret do painel Metered
PUBLIC_APP_URL="https://seu-dominio.railway.app"  # URL base para links de chamada

# Frontend (prefixo VITE_ expõe para o browser)
VITE_METERED_DOMAIN="tecfagchat.metered.live"
VITE_METERED_SECRET=""
